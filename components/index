      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Outfit:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <div class="atmosphere" aria-hidden="true">
      <span class="orb orb-a"></span>
      <span class="orb orb-b"></span>
      <span class="orb orb-c"></span>
      <span class="grid"></span>
    </div>

    <main class="stage">
      <p class="kicker">A focused mark</p>

      <h1 class="title" aria-label="cursor.purchase">
        <span class="title-glow" aria-hidden="true">cursor.purchase</span>
        <span class="title-text">
          <span class="word" data-text="cursor.purchase">cursor.purchase</span>
        </span>
        <span class="scan" aria-hidden="true"></span>
      </h1>

      <div class="rule" aria-hidden="true">
        <span class="rule-line"></span>
        <span class="rule-dot"></span>
        <span class="rule-line"></span>
      </div>

      <a
        class="source"
        href="https://discord.gg/A8eKWqWaMJ"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="source-url">purchase from discord</span>
        <span class="source-arrow" aria-hidden="true">↗</span>
      </a>
    </main>
